# ===== 飞书机器人配置（复制本文件为 .env 并填写） =====

# 应用凭证（飞书开放平台 -> 你的应用 -> 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret

# 机器人名称（用于日志显示和 @ 识别，必须和飞书后台的应用名一致）
FEISHU_BOT_NAME=现场待办助手

# 待办关键词（逗号分隔，命中即视为待办项）
TODO_KEYWORDS=待办,记得,需要,遗漏,未处理,别忘了,提醒,跟进,确认,验收

# 日报定时推送时间（24小时制 HH:MM，本机时区）
DAILY_REPORT_TIME=18:00

# 群聊日报推送时间（24小时制 HH:MM，本机时区）
GROUP_SUMMARY_TIME=18:30

# 默认推送目标（私聊 open_id，ou_ 开头；push.py 不传 --to 时用这个）
FEISHU_REPORT_TARGET=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
